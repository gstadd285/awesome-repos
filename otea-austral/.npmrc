save-exact=true
engine-strict=true
# Ningún paquete ejecuta scripts al instalarse (plan de seguridad, control 20): un paquete comprometido no
# puede correr código en tu equipo ni en la CI solo por instalarlo. Solo 3 paquetes los tienen (fsevents,
# solo macOS, y unrs-resolver, que trae sus binarios como dependencias opcionales) y no hacen falta. Los
# scripts de package.json (`npm run …`) siguen funcionando.
ignore-scripts=true
